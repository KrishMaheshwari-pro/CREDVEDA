# Example environment file for CredVeda
# Copy this to .env and replace the placeholders with your API keys.

OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-3.5-turbo
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-1.5-pro

# Data-source API keys (enable real news sentiment & earnings-transcript analysis)
# NewsAPI  -> https://newsapi.org  (free tier available)
NEWS_API_KEY=YOUR_NEWS_API_KEY_HERE
# API-Ninjas -> https://api-ninjas.com  (free tier; earnings transcripts)
API_NINJAS_KEY=YOUR_API_NINJAS_KEY_HERE
